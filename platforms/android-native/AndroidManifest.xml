    <application android:name=".ShapeShiftApplication" android:label="Shape Shift" android:appCategory="game" android:theme="@style/AppTheme" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
